{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)",        "destination": "/api/index" },
    { "source": "/admin",           "destination": "/public/admin.html" },
    { "source": "/admin-dashboard", "destination": "/public/admin-dashboard.html" },
    { "source": "/",                "destination": "/public/index.html" },
    { "source": "/(.*)",            "destination": "/public/$1" }
  ]
}
